{
  "name": "@abhishekchalla/services",
  "description": "[Currently,] An environment agnostic package of services to fetch and organise data from third party services (Notion)",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "runs": "dotenv -e ../.env -- ts-node -r tsconfig-paths/register",
    "get-notion-data": "yarn runs ./src/get-notion-data.ts",
    "test": "dotenv -e ../.env -- jest --watchman=false"
  },
  "dependencies": {
    "@abhishekchalla/config": "*",
    "@abhishekchalla/notion": "*",
    "@abhishekchalla/orm": "*",
    "@abhishekchalla/schema": "*",
    "@aws-sdk/client-s3": "^3.1163.0",
    "axios": "^1.13.5",
    "lodash": "^4.17.23",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
